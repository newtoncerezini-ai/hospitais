{
  "name": "painel-unidades-saude-pe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:data": "python scripts/build_data.py",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run build:data",
    "build": "tsc -b && vite build",
